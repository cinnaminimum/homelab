#!/usr/bin/env python

from subprocess import run
from sys import argv, exit, stderr, stdin, stdout


def main(args: list[str]) -> None:
    process = run(
        ["mise", "run", "git:commit-msg", "--", *args],
        check=False,
        stderr=stderr,
        stdin=stdin,
        stdout=stdout,
    )
    exit(process.returncode)


if __name__ == "__main__":
    main(argv[1:])
