#!/usr/bin/env python

from subprocess import run
from sys import exit, stderr, stdin, stdout


def main() -> None:
    process = run(
        ["mise", "run", "git:pre-commit"],
        check=False,
        stderr=stderr,
        stdin=stdin,
        stdout=stdout,
    )
    exit(process.returncode)


if __name__ == "__main__":
    main()
